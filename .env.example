# ==========================================
# 1. 模型與介面登入設定
# ==========================================
# 指定 Google Gemini 模型名稱（例如 gemini-3.6-flash 或 gemini-3.1-pro）
GEMINI_MODEL=gemini-3.6-flash

# 允許透過網頁登入輸入的 API Key 長度（預設 39 為原生 Gemini Key，53 為自訂代理 Key；填 0 則不限特定碼數）
ALLOWED_KEY_LENGTHS=39,53

# 若僅於本機單人使用且不想每次在網頁貼上金鑰，可填入下方並將 SKIP_WEB_AUTH 設為 true
GEMINI_API_KEY=
SKIP_WEB_AUTH=false

# Gradio 伺服器綁定設定（預設 127.0.0.1 僅限本機安全存取；若搭配內網通道可依需求調整）
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=8085

# ==========================================
# 2. 本地法規庫與輸出路徑設定
# ==========================================
LAW_DB_ROOT=./law_db
CASE_FILES_DIR=./law_db/案例事實
OUTPUT_DIR=./outputs
# 選填：若欲自動同步備份報告至雲端硬碟資料夾，請填寫完整路徑，留空則略過
BACKUP_DIR=

# ==========================================
# 3. 選配：外部雲端判決與法規檢索 (twlegalrag CLI)
# ==========================================
# 若系統已安裝 `pip install twlegalrag`：
# auto = 偵測到金鑰或本機 OAuth 登入紀錄時自動啟用；false = 強制停用
ENABLE_TLR_CLOUD=auto
TWLEGALRAG_TLR_API_KEY=
TLR_TOP_N=8

# ==========================================
# 4. 選配：Telegram / LINE 自動推播通知
# ==========================================
# 未填寫時系統會自動略過推播，僅將報告存於 ./outputs
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN_LEGAL=
TELEGRAM_BOT_TOKEN_MEETING=
TELEGRAM_BOT_TOKEN_FINANCE=

LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_USER_ID=
